# CareerOS frontend — copy to .env (and optionally .env.local).
# Never commit .env or .env.local.

# Supabase (must match backend SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your_supabase_anon_key

# Backend API
# Local:  http://localhost:5000
# Live:   https://career-os-back.onrender.com   (no trailing slash)
VITE_API_URL=http://localhost:5000
